<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>H2 Biology: Translation Simulator</title>
    <style>
        :root {
            --ribosome-color: #ffeb3b;
            --mrna-color: #4caf50;
            --trna-color: #2196f3;
            --aa-color: #f44336;
            --text-main: #333;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            background-color: #f0f2f5;
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        header {
            text-align: center;
            margin-bottom: 20px;
        }

        h1 { color: #1a237e; margin-bottom: 5px; font-size: 1.5rem; }
        p { font-size: 0.9rem; color: #555; max-width: 500px; }

        /* Simulation Box */
        #game-container {
            width: 100%;
            max-width: 600px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            overflow: hidden;
            position: relative;
            padding-bottom: 20px;
        }

        /* The Ribosome Model */
        #visualizer {
            height: 300px;
            position: relative;
            background: #e3f2fd;
            border-bottom: 4px solid #ddd;
            overflow: hidden;
        }

        .ribosome-large {
            position: absolute;
            bottom: 60px;
            left: 50%;
            transform: translateX(-50%);
            width: 280px;
            height: 180px;
            background: var(--ribosome-color);
            border-radius: 100px 100px 20px 20px;
            border: 4px solid #fbc02d;
            z-index: 1;
        }

        .epa-sites {
            display: flex;
            justify-content: space-around;
            padding-top: 40px;
            font-weight: bold;
            color: #d4a017;
        }

        .site-label { font-size: 1.2rem; }

        .mrna-strand {
            position: absolute;
            bottom: 30px;
            width: 200%;
            height: 30px;
            background: var(--mrna-color);
            display: flex;
            transition: left 0.5s ease;
            z-index: 2;
        }

        .codon {
            width: 60px;
            height: 100%;
            border-right: 1px solid white;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
            font-family: monospace;
            font-size: 0.8rem;
            font-weight: bold;
        }

        /* tRNA Component */
        .trna {
            position: absolute;
            width: 50px;
            height: 100px;
            bottom: 80px;
            transition: all 0.5s ease;
            z-index: 5;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .amino-acid {
            width: 30px;
            height: 30px;
            background: var(--aa-color);
            border-radius: 50%;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.6rem;
            border: 2px solid #b71c1c;
        }

        .trna-body {
            width: 4px;
            height: 40px;
            background: var(--trna-color);
        }

        .anticodon-box {
            background: var(--trna-color);
            color: white;
            padding: 2px 5px;
            font-size: 0.7rem;
            border-radius: 3px;
        }

        /* Controls */
        .controls {
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .info-panel {
            background: #fff9c4;
            padding: 10px;
            border-radius: 8px;
            border-left: 5px solid #fbc02d;
            font-size: 0.85rem;
            min-height: 60px;
        }

        .btn-group {
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }

        button {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 8px;
            background: #1a237e;
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s;
        }

        button:disabled { background: #ccc; }
        button:active { transform: scale(0.98); }

        .syllabus-note {
            margin-top: 15px;
            font-size: 0.75rem;
            color: #777;
            text-align: center;
        }

        /* Animations */
        @keyframes float {
            0% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
            100% { transform: translateY(0); }
        }
    </style>
</head>
<body>

<header>
    <h1>Translation Visualizer</h1>
    <p>Singapore H2 Biology (9744) - From mRNA to Polypeptide</p>
</header>

<div id="game-container">
    <div id="visualizer">
        <!-- Large Ribosomal Subunit -->
        <div class="ribosome-large">
            <div class="epa-sites">
                <div class="site-label">E</div>
                <div class="site-label">P</div>
                <div class="site-label">A</div>
            </div>
        </div>

        <!-- mRNA Strand -->
        <div class="mrna-strand" id="mrna">
            <!-- Codons injected by JS -->
        </div>

        <!-- tRNAs will be injected here -->
        <div id="trna-layer"></div>
    </div>

    <div class="controls">
        <div class="info-panel" id="status-text">
            Press "Start" to begin translation at the Start Codon (AUG).
        </div>

        <div class="btn-group">
            <button id="next-btn" onclick="nextStep()">Start Initiation</button>
            <button onclick="resetSim()" style="background:#555;">Reset</button>
        </div>
    </div>
</div>

<div class="syllabus-note">
    <strong>Key Concepts:</strong> Complementary Base Pairing (A-U, G-C), Peptidyl Transferase, 5' to 3' movement.
</div>

<script>
    const sequence = ["AUG", "UUU", "GGC", "UAA"];
    const aminoMap = { "AUG": "Met", "UUU": "Phe", "GGC": "Gly", "UAA": "STOP" };
    const antiMap = { "AUG": "UAC", "UUU": "AAA", "GGC": "CCG", "UAA": "---" };

    let step = 0;
    let currentCodonIdx = 0;
    const mrnaEl = document.getElementById('mrna');
    const statusEl = document.getElementById('status-text');
    const nextBtn = document.getElementById('next-btn');
    const trnaLayer = document.getElementById('trna-layer');

    // Initialize mRNA
    function init() {
        mrnaEl.innerHTML = '';
        sequence.forEach(c => {
            const div = document.createElement('div');
            div.className = 'codon';
            div.innerHTML = `<span>${c}</span>`;
            mrnaEl.appendChild(div);
        });
        mrnaEl.style.left = "160px"; // Start position aligned with P site
    }

    function nextStep() {
        if (step === 0) {
            initiation();
        } else if (step === 1) {
            elongationA();
        } else if (step === 2) {
            peptideBond();
        } else if (step === 3) {
            translocation();
        } else if (step === 4) {
            termination();
        }
    }

    function initiation() {
        statusEl.innerHTML = "<strong>Initiation:</strong> Small subunit binds to mRNA. Initiator tRNA (carrying Met) binds to the <b>P-site</b> via complementary base pairing between AUG codon and UAC anticodon.";
        
        spawnTRNA(0, "P");
        nextBtn.innerText = "Next: Elongation (A-site)";
        step = 1;
    }

    function elongationA() {
        currentCodonIdx++;
        if (sequence[currentCodonIdx] === "UAA") {
            step = 4;
            nextStep();
            return;
        }

        statusEl.innerHTML = "<strong>Elongation:</strong> The next aminoacyl-tRNA binds to the <b>A-site</b>. Its anticodon matches the mRNA codon.";
        spawnTRNA(currentCodonIdx, "A");
        nextBtn.innerText = "Next: Peptide Bond";
        step = 2;
    }

    function peptideBond() {
        statusEl.innerHTML = "<strong>Peptide Bond:</strong> Peptidyl transferase (rRNA in large subunit) catalyses a peptide bond between amino acids. The chain moves to the A-site tRNA.";
        
        // Visual logic: Move P-site AA to A-site AA
        const tRNAs = document.querySelectorAll('.trna');
        const pTRNA = tRNAs[tRNAs.length - 2];
        const aTRNA = tRNAs[tRNAs.length - 1];
        
        const pAA = pTRNA.querySelector('.amino-acid');
        pAA.style.transition = "all 0.5s ease";
        pAA.style.transform = "translate(70px, -10px)";
        
        nextBtn.innerText = "Next: Translocation";
        step = 3;
    }

    function translocation() {
        statusEl.innerHTML = "<strong>Translocation:</strong> Ribosome moves 5' to 3'. tRNA in P-site moves to E-site and exits. tRNA in A-site moves to P-site.";
        
        // Move mRNA
        const currentLeft = parseInt(mrnaEl.style.left);
        mrnaEl.style.left = (currentLeft - 70) + "px";

        // Move tRNAs
        const tRNAs = document.querySelectorAll('.trna');
        tRNAs.forEach(t => {
            const pos = parseInt(t.style.left);
            t.style.left = (pos - 70) + "px";
            if (pos - 70 < 100) { // E-site exit logic
                t.style.opacity = "0";
                setTimeout(() => t.remove(), 500);
            }
        });

        nextBtn.innerText = "Next: Continue Elongation";
        step = 1;
    }

    function termination() {
        statusEl.innerHTML = "<strong>Termination:</strong> Stop codon (UAA) is reached. A release factor binds to A-site. The polypeptide is hydrolyzed and the complex dissociates.";
        nextBtn.disabled = true;
        nextBtn.innerText = "Finished";
    }

    function spawnTRNA(idx, site) {
        const trna = document.createElement('div');
        trna.className = 'trna';
        const leftPos = site === "P" ? 175 : 245;
        trna.style.left = leftPos + "px";
        
        trna.innerHTML = `
            <div class="amino-acid">${aminoMap[sequence[idx]]}</div>
            <div class="trna-body"></div>
            <div class="anticodon-box">${antiMap[sequence[idx]]}</div>
        `;
        
        trnaLayer.appendChild(trna);
    }

    function resetSim() {
        step = 0;
        currentCodonIdx = 0;
        trnaLayer.innerHTML = '';
        nextBtn.disabled = false;
        nextBtn.innerText = "Start Initiation";
        statusEl.innerText = 'Press "Start" to begin.';
        init();
    }

    init();
</script>

</body>
</html>
